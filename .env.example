# Copie este archivo a .env y ajuste los valores. docker compose lo carga automáticamente.

# --- Modelo (obligatorio para respuestas reales) ------------------------------
# Sin clave, el asistente funciona en modo offline: solo devuelve extractos literales de la documentación.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
LLM_PROVIDER_ORDER=anthropic,mock
ALLOW_MOCK_LLM=true

# --- Puertos del anfitrión ----------------------------------------------------
PWA_HTTP_PORT=80
PWA_HTTPS_PORT=443
KEYCLOAK_HOST_PORT=8080
API_HOST_PORT=8000
MCP_HOST_PORT=9000
QDRANT_HOST_PORT=6333

# --- Identidad (Keycloak) -----------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
# Emisores aceptados en los JWT: uno por cada origen desde el que se abre la PWA (con puerto si no es 80/443)
# y el acceso directo a Keycloak.
KEYCLOAK_ALLOWED_ISSUERS=http://localhost:8080/realms/asesoria-realm,http://localhost/realms/asesoria-realm,https://localhost/realms/asesoria-realm
TLS_EXTRA_SAN=

# --- Revisión y privacidad ----------------------------------------------------
# Las respuestas a clientes quedan retenidas hasta que un gestor las aprueba
REVIEW_CLIENT_ANSWERS=true
# Enmascarar NIF/NIE/CIF, IBAN, teléfonos y correos antes de enviar texto al modelo
PII_MASKING=true
# Secreto compartido API Gateway <-> servidor de expedientes para firmar (HMAC) las revisiones
MCP_APPROVAL_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio

PUBLIC_BASE_URL=http://localhost:8000
