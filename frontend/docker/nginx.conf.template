# Generado por envsubst al arrancar: ${REACT_APP_API_GATEWAY_URL} y ${REACT_APP_KEYCLOAK_URL}
# son direcciones internas de la red Docker; el navegador solo habla con este origen.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.3;

    client_max_body_size 12m;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(self)" always;

    location / {
        try_files $uri /index.html;
    }
    location = /sw.js      { add_header Cache-Control "no-cache"; }
    location = /env.js     { add_header Cache-Control "no-store"; }

    # API Gateway (REST, salud, figuras extraídas, A2A, MCP RAG)
    location ~ ^/(api|static|health|a2a|mcp-rag)(/|$) {
        proxy_pass ${REACT_APP_API_GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
    location /ws/ {
        proxy_pass ${REACT_APP_API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Keycloak servido en el mismo origen (KC_PROXY=edge interpreta las cabeceras X-Forwarded-*)
    location ~ ^/(realms|resources)/ {
        proxy_pass ${REACT_APP_KEYCLOAK_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }
}
